{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing",
  "account_id": "fdd8b5348ae948cc89bcbd8c896d3082",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker before static files too, for the www redirect and language detection.
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "matthiaspeterlini.tech", "custom_domain": true },
    { "pattern": "www.matthiaspeterlini.tech", "custom_domain": true }
  ]
}
