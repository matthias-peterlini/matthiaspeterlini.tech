{
  "$schema": "node_modules/wrangler/config-schema.json",
  // TODO: must match the Worker's name in the Cloudflare dashboard.
  "name": "matthiaspeterlini-tech",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "matthiaspeterlini.tech", "custom_domain": true }
  ]
}
